{
  "name": "tekon",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest --exclude \"**/__manual__/**\"",
    "lint": "pnpm -r lint",
    "lint:actions": "bash scripts/ci/actionlint.sh",
    "smoke:claude-provider": "npm exec --yes -- pnpm@10.12.1 --filter @tekon/core smoke:claude-provider",
    "typecheck": "pnpm -r typecheck",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.6",
    "prettier": "^3.5.3",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^2.0.0": "2.1.4",
      "brace-expansion@^5.0.0": "5.0.9",
      "postcss@^8.0.0": "8.5.26",
      "nanoid@^3.0.0": "3.3.18",
      "browserslist": ">=4.28.7",
      "esbuild": ">=0.28.1"
    }
  }
}
