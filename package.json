{
  "name": "tekon",
  "version": "0.27.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && vitest --exclude \"**/__manual__/**\"",
    "lint": "pnpm -r typecheck",
    "lint:actions": "bash scripts/ci/actionlint.sh",
    "smoke:claude-provider": "npm exec --yes -- pnpm@10.12.1 --filter @tekon/core smoke:claude-provider",
    "typecheck": "pnpm -r typecheck",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "prettier": "^3.5.3",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "postcss@^8.0.0": "8.5.26",
      "source-map-js@^1.0.0": "^1.2.2",
      "nanoid@^3.0.0": "3.3.18",
      "browserslist": ">=4.28.7",
      "esbuild": ">=0.28.1"
    }
  }
}
